# =============================================
# CRM Sales - Variables de Entorno (EJEMPLO)
# =============================================
# Copia este archivo como "backend/.env" y completa los valores.
# NUNCA subas el archivo .env real a GitHub.

# ─── Servidor ──────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
TZ=America/Guayaquil

# ─── JWT ───────────────────────────────────
# Texto largo y aleatorio (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Base de datos (PostgreSQL) ────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Meta Cloud API (WhatsApp Bot) ─────────
# Se obtienen en developers.facebook.com → tu App → WhatsApp
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WA_PHONE_ID=
WA_TOKEN=

# ─── Inteligencia Artificial ───────────────
# Opciones: claude | gemini | groq | deepseek | cerebras | openrouter
AI_PROVIDER=groq

# Claude (Anthropic) — console.anthropic.com
CLAUDE_API_KEY=

# Gemini (Google) — aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — console.groq.com (las claves _2 y _3 son opcionales, de respaldo)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FILTRO=llama-3.3-70b-versatile

# DeepSeek — platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Cerebras — inference.cerebras.ai (las claves _2 y _3 son opcionales)
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter — openrouter.ai → API Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# ─── Email (recuperación de contraseña, notificaciones) ────
# Para Gmail usa una "contraseña de aplicación", no tu contraseña normal
EMAIL_PROVIDER=gmail
EMAIL_USER=
EMAIL_PASS=

# ─── Seguridad ─────────────────────────────
# Texto aleatorio para las rutas de administración del bot
ADMIN_SECRET=

# ─── Bot Config ────────────────────────────
BOT_RESPONSE_TIMEOUT_MINUTES=30
MAX_BOT_ROUNDS=5
BOT_MONTHLY_BUDGET=25
